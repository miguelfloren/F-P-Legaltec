RewriteEngine On

# Canonical host: pflegaltec.com (www → non-www)
RewriteCond %{HTTP_HOST} ^www\.pflegaltec\.com$ [NC]
RewriteRule ^ https://pflegaltec.com%{REQUEST_URI} [R=301,L]

# Serve index.php as directory index
DirectoryIndex index.php index.html

# Clean URLs: /servicios/derecho-laboral/ → servicios/derecho-laboral.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Clean URLs with trailing slash (subdirectory pages)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+)/$ $1.php [L]

# Trailing slash: /contacto → /contacto/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-z]+|/)$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# Long cache for static assets
<FilesMatch "\.(css|js|webp|jpg|jpeg|png|woff2|svg|ico)$">
  Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
